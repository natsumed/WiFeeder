        P2["GPIO9  (SPI0 MISO)"]
        P3["GPIO10 (SPI0 MOSI)"]
        P4["GPIO8  (SPI0 CE0)"]
        P5["GPIO25 (GPIO)"]
        P6["GPIO24 (GPIO)"]
    end

    subgraph NRF["NRF24L01+ Module"]
        N1["SCK"]
        N2["MISO"]
        N3["MOSI"]
